 "name": "Taz'Rah",
 "sections": [
  {
   "body_text": "Taz'Rah summons Ethereal Shades that perform [Nether Dash], damaging targets in a line in front of them.\r\n\r\nTaz'rah's [Dark Bloom] causes [Void Fissures] to erupt.",
   "id": 32963,
   "sections": [
    {
     "body_text": "$bullet;Ethereal Shades periodically cast [Nether Dash] on a random player, damaging targets in a line in front of them.\r\n$bullet;[Dark Bloom] causes [Void Fissures] to erupt.",
     "id": 32964,
     "title": "Damage Dealers"
    },
    {
     "body_text": "$bullet;[Nether Dash] strikes all players in a line and inflicts Shadow damage over a long duration.\r\n$bullet;[Dark Bloom] inflicts heavy Shadow damage on all players and causes [Void Fissures] to erupt.",
     "id": 32965,
     "title": "Healers"
    },
    {
     "body_text": "$bullet;[Void Blast] inflicts heavy Shadowstrike damage.\r\n$bullet;[Dark Bloom] causes [Void Fissures] to erupt.",
     "id": 32966,
     "title": "Tanks"
    }
   ],
