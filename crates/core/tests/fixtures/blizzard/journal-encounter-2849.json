 "name": "Nymrissa Wavecaller",
 "sections": [
  {
   "body_text": "Nymrissa Wavecaller creates an [Alluring Bubble] within the grotto that lures nearby murlocs into her grasp. She then summons [Swirling Whirlpools] to break the bubble, empowering murlocs within.",
   "id": 34109,
   "sections": [
    {
     "body_text": "$bullet;[Water Jet] inflicts sustained damage to Nymrissa Wavecaller's current target, and removes icy patches of [Lingering Frost].\r\n$bullet;[Alluring Bubble] attracts a large group of Bubblefin Shorerunners to rush toward the giant bubble.",
     "id": 35757,
     "title": "Tank"
    },
    {
     "body_text": "$bullet;[Iceblade Flurry] inflicts sustained damage to Nymrissa Wavecaller's current target.\r\n$bullet;[Alluring Bubble] attracts a large group of Bubblefin Shorerunners to rush toward the giant bubble.",
     "id": 34110,
     "title": "Tank"
    },
    {
     "body_text": "$bullet;[Abyssal Rain] inflicts significant damage to all players.\r\n$bullet;[Alluring Bubble] inflicts a large burst of damage to all players when it [Pops!]",
     "id": 36631,
     "title": "Healer"
    },
    {
     "body_text": "$bullet;[Alluring Bubble] attracts a large group of Bubblefin Shorerunners to rush toward the giant bubble.\r\n$bullet;Murlocs that enter a [Alluring Bubble] become empowered.",
     "id": 34111,
     "title": "Damage Dealers"
    }
   ],
