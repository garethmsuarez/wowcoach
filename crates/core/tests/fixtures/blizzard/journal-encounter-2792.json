 "name": "Atroxus",
 "sections": [
  {
   "body_text": "Atroxus assaults players with its powerful venoms using [Noxious Breath] and [Poison Splash]. Its [Monstrous Roar] inflicts heavy physical damage to all players summons a Toxic Creeper.",
   "id": 32971,
   "sections": [
    {
     "body_text": "$bullet;[Noxious Breath] inflicts high damage in front of Atroxus.\r\n\r\n$bullet;[Monstrous Roar] inflicts heavy physical damage to all players summons a Toxic Creeper to attack its target.",
     "id": 32972,
     "title": "Damage Dealers"
    },
    {
     "body_text": "$bullet;[Hulking Claw] inflicts high Nature damage to the primary target.\r\n\r\n$bullet;[Noxious Breath] inflicts high damage in front of Atroxus.",
     "id": 32973,
     "title": "Healers"
    },
    {
     "body_text": "$bullet;[Hulking Claw] inflicts high Nature damage to the primary target.\r\n\r\n$bullet;[Sickening Bite] applies stacking vulnerability to Nature damage.",
     "id": 32974,
     "title": "Tanks"
    }
   ],
